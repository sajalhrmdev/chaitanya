{
  "info": {
    "name": "Chaitanya Museum - Camping & Booking API Collection",
    "description": "Complete API collection for Camping Management and Booking modules",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://chaitanyaback.onrender.com"
    }
  ],
  "item": [
    {
      "name": "🏕️ Camping Events",
      "item": [
        {
          "name": "Get All Campings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/camping"
          }
        },
        {
          "name": "Create Camping",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/camping",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camping_name\": \"Health Camp Mayapur\",\n  \"location\": \"Mayapur, Nadia\",\n  \"start_date\": \"2025-07-01\",\n  \"end_date\": \"2025-07-03\",\n  \"organizer_name\": \"Dr. Sharma\",\n  \"contact_details\": \"9876543210\",\n  \"participants_count\": 50,\n  \"remarks\": \"Free eye checkup\",\n  \"doctors\": \"Dr. Sharma, Dr. Roy\"\n}"
            }
          }
        },
        {
          "name": "Update Camping",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/camping/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camping_name\": \"Health Camp Mayapur Updated\",\n  \"location\": \"Mayapur, Nadia\",\n  \"start_date\": \"2025-07-01\",\n  \"end_date\": \"2025-07-05\",\n  \"organizer_name\": \"Dr. Sharma\",\n  \"contact_details\": \"9876543210\",\n  \"participants_count\": 100,\n  \"remarks\": \"Free eye + dental checkup\",\n  \"doctors\": \"Dr. Sharma, Dr. Roy, Dr. Das\"\n}"
